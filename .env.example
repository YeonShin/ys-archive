# ============================================================
# 사용법: 이 파일을 복사해 .env.local 을 만들고 값을 채우세요.
#   cp .env.example .env.local
# .env.local 은 커밋하지 마세요. (실제 키는 절대 공유 금지)
# ============================================================

# ------------------------------------------------------------
# Supabase (필수)
# Supabase Dashboard(https://supabase.com/dashboard) > 프로젝트 선택
# ------------------------------------------------------------

# 프로젝트 URL
# 위치: Project Settings > API > Project URL
# 예: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# 공개용(anon) 키. 브라우저에 노출되어도 되며, 접근 제어는 RLS 정책이 담당합니다.
# 위치: Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 서버 전용(service_role) 키. RLS를 우회하는 관리자 권한 키입니다.
# 방명록 수정·삭제 등 서버에서만 사용하며, 절대 클라이언트 코드나 저장소에 노출하지 마세요.
# NEXT_PUBLIC_ 접두사를 붙이면 안 됩니다.
# 위치: Project Settings > API > Project API keys > service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-role-key

# 프로젝트 Reference ID (npx supabase link --project-ref 에서 사용하는 값과 동일)
# 위치: Project Settings > General > Project ID
# 예: abcdefghijklmnop
NEXT_PUBLIC_SUPABASE_PROJECT_ID=your-supabase-project-id

# ------------------------------------------------------------
# Vercel Analytics (선택)
# 어드민 대시보드의 방문자 통계용입니다.
# 비워두면 앱은 정상 동작하고, 대시보드의 방문자 수만 0으로 표시됩니다.
# ------------------------------------------------------------

# Vercel API 접근 토큰
# 위치: Vercel > Account Settings > Tokens > Create Token
VERCEL_ACCESS_TOKEN=your-vercel-access-token

# 통계를 조회할 Vercel 프로젝트 ID
# 위치: Vercel > 프로젝트 > Settings > General > Project ID (prj_로 시작)
VERCEL_PROJECT_ID=your-vercel-project-id
